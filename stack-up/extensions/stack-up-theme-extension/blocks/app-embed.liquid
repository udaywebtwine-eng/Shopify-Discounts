<span data-stackup-embed-active id="stackup-embed-marker" hidden style="display:none !important;"></span>
<script>
  (function() {
    function markActive() {
      if (document.documentElement) {
        document.documentElement.classList.add('stackup-active');
      }
      if (document.body) {
        document.body.classList.add('stackup-active');
      }
      window.StackUpAppEmbedActive = true;
    }
    markActive();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markActive);
    }
  })();
</script>

{% schema %}
{
  "name": "StackUp Bundles",
  "target": "body",
  "stylesheet": "stack-up.css",
  "javascript": "stack-up.js",
  "settings": []
}
{% endschema %}
