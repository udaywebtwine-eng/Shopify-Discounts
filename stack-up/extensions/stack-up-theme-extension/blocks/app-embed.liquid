<!-- StackUp Theme App Embed -->
{{ 'stack-up.css' | asset_url | stylesheet_tag }}
{{ 'stack-up.js' | asset_url | script_tag }}

<span data-stackup-embed-active hidden style="display:none !important;"></span>
<script>
  if (document.body) {
    document.body.classList.add('stackup-active');
  }
  window.StackUpAppEmbedActive = true;
</script>

{% schema %}
{
  "name": "StackUp Bundles",
  "target": "body",
  "stylesheet": "stack-up.css",
  "javascript": "stack-up.js",
  "settings": []
}
{% endschema %}
