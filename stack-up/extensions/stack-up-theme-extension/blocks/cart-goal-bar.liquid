{% comment %}
  StackUp - Cart Goal & Tiered Cart-Value Discount Progress Bar
  Target: section (Cart Drawer or Cart Page block)
{% endcomment %}

{% assign app_status = shop.metafields.stack_up.stack_up_app_enabled.value %}
{% assign is_app_enabled = true %}
{% if app_status == 'false' or app_status == false %}
  {% assign is_app_enabled = false %}
{% endif %}

{% if is_app_enabled %}
  {% assign cart_goal_data = shop.metafields.stack_up.cart_goal_offers.value %}
  {% assign cart_goal_widget_settings = shop.metafields.stack_up.cart_goal_widget_settings.value %}
  {% assign is_editor = request.design_mode %}

  {% if cart_goal_data != blank or is_editor %}
    <script id="stackup-cart-goal-config" type="application/json">
      {% if cart_goal_data != blank %}
        {% if cart_goal_data.first %}
          {{ cart_goal_data | json }}
        {% else %}
          {{ cart_goal_data | replace: '</script>', '<\/script>' }}
        {% endif %}
      {% else %}
        []
      {% endif %}
    </script>
    {% if cart_goal_widget_settings != blank %}
      <script id="stackup-cart-goal-widget-settings" type="application/json">
        {% if cart_goal_widget_settings.first %}
          {{ cart_goal_widget_settings | json }}
        {% else %}
          {{ cart_goal_widget_settings | replace: '</script>', '<\/script>' }}
        {% endif %}
      </script>
    {% endif %}
    <script id="stackup-cart-collection-map" type="application/json">
      {
        {% for item in cart.items %}
          "{{ item.product_id }}": [
            {% for c in item.product.collections %}
              "{{ c.id }}", "{{ c.handle }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    </script>
    <div
      class="stackup-cart-goal-wrapper"
      id="stackup-cart-goal-bar"
      data-cart-currency-code="{{ cart.currency.iso_code | default: shop.currency }}"
      data-cart-currency-symbol="{{ cart.currency.symbol }}"
      data-shop-currency="{{ shop.currency }}"
      data-cart-subtotal="{{ cart.original_total_price | default: cart.total_price | default: 0 }}"
    >
      <div class="stackup-cart-goal-card">
        <div class="stackup-cart-goal-header">
          <div class="stackup-cart-goal-title">Add items to unlock discount rewards!</div>
        </div>
        <div class="stackup-cart-goal-track-container">
          <div class="stackup-cart-goal-track">
            <div class="stackup-cart-goal-fill" style="width: 0%;"></div>
          </div>
          <div class="stackup-cart-goal-markers"></div>
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Cart Goal Progress Bar",
  "target": "section",
  "stylesheet": "stack-up.css",
  "javascript": "stack-up.js",
  "settings": []
}
{% endschema %}

